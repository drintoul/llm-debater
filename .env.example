# URL of the Ollama server the app connects to
# (e.g. your server's LAN IP; when running the app in Docker, localhost
# refers to the container itself, not the host running Ollama)
OLLAMA_HOST=http://localhost:11434

# Comma-separated list of models offered in the debate dropdowns
# (models must be pulled on the Ollama server first: ollama pull <model>)
AVAILABLE_MODELS=llama3.1:8b,llama3.2:latest,qwen3:14b,phi4:latest,gemma2:9b,mistral-nemo:latest,command-r7b,hermes3:8b

# JSON map of model name -> training data cutoff date (shown in the sidebar)
# Cutoff dates are NOT sourced automatically - maintain this list manually.
# Some model creators do not publish training cutoffs; use "unknown" for those.
MODEL_CUTOFF_DATES='{"llama3.1:8b":"December 2023","llama3.2:latest":"December 2023","qwen3:14b":"March 2025","phi4:latest":"June 2024","gemma2:9b":"June 2024","mistral-nemo:latest":"unknown","command-r7b":"unknown","hermes3:8b":"December 2023"}'

# Debate settings
MAX_ROUNDS=5
DEFAULT_ROUNDS=3

# Port the app is served on (docker compose maps this to container port 8501)
APP_PORT=8505
